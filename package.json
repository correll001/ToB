{
  "name": "tob",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -H 127.0.0.1 -p 3000",
    "build": "next build --webpack",
    "start": "next start -H 127.0.0.1 -p 3000",
    "etl:skills:index": "tsx scripts/etl/fetchSkillIndexes.ts",
    "etl:skills:pages": "tsx scripts/etl/fetchSkillPages.ts",
    "etl:skills": "npm run etl:skills:index && npm run etl:skills:pages",
    "etl:normalize:skills": "tsx scripts/etl/normalizeSkills.ts",
    "etl:normalize:rules": "tsx scripts/etl/normalizeGlobalRules.ts",
    "etl:normalize": "tsx scripts/etl/normalizeData.ts",
    "etl:apply-overrides": "tsx scripts/etl/applyOverrides.ts",
    "etl:diff-season": "tsx scripts/etl/diffSeasonData.ts",
    "check:skill-engine": "tsx lib/formula/skills/skillEngineSmokeTest.ts",
    "check:data-policy": "tsx scripts/checkNoRuntimeTlidb.ts",
    "audit:no-external-runtime-fetch": "tsx scripts/audit/noExternalRuntimeFetch.ts",
    "audit:no-runtime-remote-skill-fetch": "tsx scripts/audit/noRuntimeRemoteSkillFetch.ts",
    "verify:skill-data-integrity": "tsx scripts/verify/verifySkillDataIntegrity.ts",
    "verify:skill-regression": "tsx scripts/verify/skillRegressionCases.ts",
    "verify:p0-active-level-tables": "tsx scripts/verify/verifyP0ActiveLevelTables.ts",
    "verify:inspected-skill-selectors": "tsx scripts/verify/verifyInspectedSkillSelectors.ts",
    "verify:4e": "npm run verify:skill-data-integrity && npm run verify:skill-regression && npm run verify:p0-active-level-tables && npm run verify:inspected-skill-selectors && npm run check:skill-engine",
    "report:structured-skill-coverage": "tsx scripts/verify/reportStructuredSkillCoverage.ts",
    "data:import:effective": "tsx scripts/import/importEffectiveData.ts",
    "data:freeze:from-effective": "tsx scripts/import/freezeEffectiveDataset.ts",
    "data:verify:local": "tsx scripts/verify/verifyLocalDataset.ts",
    "data:verify:frozen": "tsx scripts/verify/verifyFrozenDataset.ts",
    "release:check": "npm run audit:no-external-runtime-fetch && npm run audit:no-runtime-remote-skill-fetch && npm run check:data-policy && npm run data:verify:local && npm run verify:skill-data-integrity && npm run verify:skill-regression && npm run verify:p0-active-level-tables && npm run verify:inspected-skill-selectors && npm run check:skill-engine && npm run build"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "immer": "^11.1.4",
    "lz-string": "^1.5.0",
    "next": "^16.2.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25.5.0",
    "@types/react": "19.2.14",
    "autoprefixer": "^10.4.27",
    "cheerio": "^1.2.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "6.0.2"
  }
}
