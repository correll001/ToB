# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# TLIDB ETL raw HTML/MD (manifests/*.json under data/raw are kept for diffs)
/data/raw/**/indexes/*.html
/data/raw/**/indexes/*.md
/data/raw/**/pages/**/*.html
/data/raw/**/pages/**/*.md

# Local SQLite (import via npm run data:import:effective); keep data/local/.gitkeep
/data/local/*.db
/data/local/*.db-journal
